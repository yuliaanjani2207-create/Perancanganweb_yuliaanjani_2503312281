<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Halaman 11: RIWAYAT ABSENSI dengan filter matkul/tanggal/kata kunci (controller: RiwayatController) -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RiwayatController" spacing="12">

    <Label text="Riwayat Absensi" styleClass="page-title"/>

    <VBox styleClass="panel" spacing="10">
        <Label text="Filter" styleClass="section"/>
        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            <Label text="Mata Kuliah" styleClass="muted"/>
            <Label text="Tanggal Awal" GridPane.columnIndex="1" styleClass="muted"/>
            <Label text="Tanggal Akhir" GridPane.columnIndex="2" styleClass="muted"/>
            <Label text="Kata Kunci (NIM/Nama)" GridPane.columnIndex="3" styleClass="muted"/>

            <ComboBox fx:id="cbMatkul" maxWidth="Infinity" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpAwal" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <DatePicker fx:id="dpAkhir" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtKeyword" promptText="mis. 2503312..." GridPane.rowIndex="1" GridPane.columnIndex="3"
                       onAction="#onFilter"/>
        </GridPane>
        <HBox spacing="8">
            <Button text="Terapkan Filter" onAction="#onFilter" styleClass="btn-primary"/>
            <Button text="Reset" onAction="#onReset" styleClass="btn-ghost"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Ekspor CSV" onAction="#onExportCsv" styleClass="btn-success"/>
        </HBox>
    </VBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="NIM" prefWidth="100">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="nim"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Nama" prefWidth="160">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="namaMahasiswa"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Kode MK" prefWidth="90">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="kodeMatkul"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Mata Kuliah" prefWidth="170">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="namaMatkul"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Pertemuan" prefWidth="90">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="pertemuanKe"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Tanggal" prefWidth="100">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="tanggal"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Waktu Absen" prefWidth="150">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="waktuAbsen"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Status" prefWidth="90">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="status"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Metode" prefWidth="80">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="metode"/></cellValueFactory>
            </TableColumn>
        </columns>
        <columnResizeMode>CONSTRAINED_RESIZE_POLICY</columnResizeMode>
    </TableView>
</VBox>
