<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Halaman 7 & 8: PEMBUATAN SESI ABSENSI + TAMPILAN QR CODE DINAMIS (controller: SesiController) -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SesiController" spacing="12">

    <Label text="Sesi Absensi &amp; QR Code Dinamis" styleClass="page-title"/>
    <Label wrapText="true" styleClass="muted"
           text="Pilih sesi pertemuan lalu tekan 'Mulai Sesi'. Sistem menerbitkan token HMAC unik per rotasi; QR berganti otomatis setiap masa berlaku habis. Menutup sesi menggugurkan seluruh token sesi."/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Sesi:" styleClass="muted"/>
        <ComboBox fx:id="cbSesi" prefWidth="420" onAction="#onSesiChanged"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <GridPane hgap="8" vgap="8">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <Button text="▶ Mulai Sesi" onAction="#onStartSession" styleClass="btn-success"/>
        <Button text="↻ Rotasi QR Sekarang" GridPane.columnIndex="1" onAction="#onRotateNow" styleClass="btn-primary"/>
        <Button text="■ Tutup Sesi" GridPane.columnIndex="2" onAction="#onCloseSession" styleClass="btn-danger"/>
        <Button text="Simpan QR (PNG)" GridPane.columnIndex="3" onAction="#onSaveQrPng" styleClass="btn-ghost"/>
    </GridPane>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Panel QR Code -->
        <VBox fx:id="qrPane" styleClass="panel" alignment="TOP_CENTER" spacing="8" prefWidth="380">
            <Label text="TAYANGAN QR CODE DINAMIS" styleClass="section"/>
            <Label fx:id="lblInfoSesi" wrapText="true" styleClass="muted" text="Pilih sesi perkuliahan." textAlignment="CENTER"/>
            <ImageView fx:id="imgQr" fitWidth="320" fitHeight="320" preserveRatio="true"/>
            <Label fx:id="lblCountdown" styleClass="countdown" text="">
                <font><Font size="16"/></font>
            </Label>
            <Label fx:id="lblStatus" wrapText="true" textAlignment="CENTER"
                   text="Belum ada sesi aktif."/>
        </VBox>

        <!-- Panel daftar hadir live -->
        <VBox styleClass="panel" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="PANTAUAN KEHADIRAN REAL-TIME" styleClass="section"/>
            <Label fx:id="lblHadir" wrapText="true" styleClass="hadir-text"/>
            <Separator/>
            <Label fx:id="lblBelum" wrapText="true" styleClass="muted"/>
        </VBox>
    </HBox>
</VBox>
