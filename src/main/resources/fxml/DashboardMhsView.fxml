<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Halaman 2b: DASHBOARD MAHASISWA (controller: DashboardMhsController) -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DashboardMhsController" spacing="16">

    <Label fx:id="lblWelcome" styleClass="page-title"/>
    <Label fx:id="lblNim" styleClass="muted"/>

    <VBox styleClass="panel, card-icon-accent" spacing="10">
        <Label text="Ringkasan kehadiran per mata kuliah" styleClass="section"/>
        <Label fx:id="lblSummary" wrapText="true" styleClass="info-label"/>
    </VBox>

    <Label wrapText="true" styleClass="muted"
           text="Petunjuk: buka menu 'Scan QR Absensi' saat dosen menampilkan QR Code dinamis di kelas. QR berganti setiap beberapa detik — segera pindai sebelum kedaluwarsa."/>
</VBox>
