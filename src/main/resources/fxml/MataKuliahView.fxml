<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Halaman 5: MATA KULIAH + PESERTA (controller: MataKuliahController extends CrudController) -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MataKuliahController" spacing="12">

    <Label text="Pengelolaan Mata Kuliah &amp; Peserta (KRS)" styleClass="page-title"/>

    <HBox spacing="8">
        <TextField fx:id="txtSearch" promptText="Cari kode / nama mata kuliah..." prefWidth="320" onAction="#onSearch"/>
        <Button text="Cari" onAction="#onSearch" styleClass="btn-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ekspor CSV" onAction="#onExportCsv" styleClass="btn-ghost"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" prefWidth="55">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="id"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Kode" prefWidth="100">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="kode"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Nama Mata Kuliah" prefWidth="260">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="nama"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="SKS" prefWidth="60">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="sks"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Dosen Pengampu" prefWidth="220">
                <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="namaDosen"/></cellValueFactory>
            </TableColumn>
        </columns>
        <columnResizeMode>CONSTRAINED_RESIZE_POLICY</columnResizeMode>
    </TableView>

    <VBox styleClass="panel" spacing="10">
        <Label text="Formulir Mata Kuliah (biarkan ID kosong untuk data baru)" styleClass="section"/>
        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="12"/><ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="8"/><ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="20"/>
            </columnConstraints>
            <Label text="ID" styleClass="muted"/>
            <Label text="Kode MK" GridPane.columnIndex="1" styleClass="muted"/>
            <Label text="SKS" GridPane.columnIndex="2" styleClass="muted"/>
            <Label text="Nama Mata Kuliah" GridPane.columnIndex="3" styleClass="muted"/>
            <Label text="Dosen Pengampu" GridPane.columnIndex="4" styleClass="muted"/>

            <TextField fx:id="txtId" editable="false" GridPane.rowIndex="1"/>
            <TextField fx:id="txtKode" promptText="mis. IF301" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <TextField fx:id="txtSks" promptText="3" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtNama" promptText="mis. Basis Data" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            <ComboBox fx:id="cbDosen" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
        </GridPane>
        <HBox spacing="8">
            <Button text="Baru" onAction="#onNew" styleClass="btn-ghost"/>
            <Button text="Pilih ke Form (Ubah)" onAction="#onEdit" styleClass="btn-warning"/>
            <Button text="Simpan" onAction="#onSave" styleClass="btn-success"/>
            <Button text="Hapus" onAction="#onDelete" styleClass="btn-danger"/>
        </HBox>
    </VBox>

    <!-- Panel peserta: pilih mata kuliah pada tabel di atas, lalu kelola pesertanya -->
    <VBox styleClass="panel" spacing="8">
        <Label text="Peserta Mata Kuliah Terpilih (klik baris tabel untuk memilih)" styleClass="section"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="cbMahasiswa" promptText="Pilih mahasiswa..." prefWidth="300"/>
            <Button text="+ Tambah Peserta" onAction="#onAddPeserta" styleClass="btn-success"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblInfoPeserta" styleClass="muted"/>
        </HBox>
        <TableView fx:id="tablePeserta" prefHeight="150">
            <columns>
                <TableColumn text="NIM" prefWidth="120">
                    <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="nim"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Nama Mahasiswa" prefWidth="240">
                    <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="namaMahasiswa"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Kode MK" prefWidth="110">
                    <cellValueFactory><javafx.scene.control.cell.PropertyValueFactory property="kodeMatkul"/></cellValueFactory>
                </TableColumn>
            </columns>
            <columnResizeMode>CONSTRAINED_RESIZE_POLICY</columnResizeMode>
        </TableView>
        <Label wrapText="true" styleClass="muted"
               text="Klik baris peserta untuk mengeluarkan mahasiswa dari mata kuliah. Hanya peserta terdaftar yang boleh absen pada sesi mata kuliah tersebut."/>
    </VBox>
</VBox>
